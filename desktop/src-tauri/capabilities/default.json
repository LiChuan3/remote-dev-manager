{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for the Remote Dev Manager main window: window control, tray/menu, autostart toggle, and opening external URLs.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-unminimize",
    "core:window:allow-set-focus",
    "core:window:allow-is-visible",
    "core:app:allow-app-hide",
    "core:tray:default",
    "core:menu:default",
    "shell:allow-open",
    "opener:default",
    "opener:allow-open-url",
    "autostart:default",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled"
  ]
}
